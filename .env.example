# ============================================================
# finance-consultant — environment configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- LLM Provider ---
# OpenAI-compatible API key. Supports DeepSeek, Kimi, Qwen, etc.
# DeepSeek is recommended for China users (accessible, cheap, strong reasoning).
LLM_API_KEY=your_api_key_here

# Base URL for an OpenAI-compatible endpoint.
# DeepSeek: https://api.deepseek.com
# Kimi:     https://api.moonshot.cn/v1
# Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:   https://api.openai.com/v1  (default if unset)
LLM_BASE_URL=https://api.deepseek.com

# Model names for the two reasoning tiers.
# DeepSeek recommended:
DEEP_THINK_MODEL=deepseek-reasoner
QUICK_THINK_MODEL=deepseek-chat

# --- China Data Vendors ---
# Tushare token (optional but recommended for A-share fundamentals)
# Register at: https://tushare.pro
TUSHARE_TOKEN=

# Path to Python 3 interpreter that has akshare + baostock installed
# Install deps: pip install akshare baostock pandas
AKSHARE_PYTHON=python3

# --- Output ---
# Language for analyst reports and final decision (Chinese or English)
OUTPUT_LANGUAGE=Chinese

# --- Analysis Settings ---
MAX_DEBATE_ROUNDS=1
MAX_RISK_ROUNDS=1

# --- Directories ---
# Where to save reports (default: ~/.finance-consultant/reports)
# RESULTS_DIR=/path/to/reports
# Where to cache data (default: ~/.finance-consultant/cache)
# DATA_CACHE_DIR=/path/to/cache
